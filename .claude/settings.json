{
  "permissions": {
    "allow": [
      "Bash(make lint)",
      "Bash(make test)",
      "Bash(make test *)",
      "Bash(make build)",
      "Bash(make check)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh api repos/*/actions/runs*)",
      "Bash(make help)",
      "Bash(make docs-check)",
      "Bash(make license)",
      "Bash(make e2e)",
      "Bash(make dast)",
      "Bash(python3 scripts/check-docs.py)",
      "Bash(python3 scripts/check-docs.py *)",
      "Bash(python3 scripts/prepare-release.py *)",
      "Read(./.env.example)",
      "Edit(./.env.example)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(docker compose *)",
      "Bash(make up)",
      "Bash(make down)",
      "Edit(./.mcp.json)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.prod*)",
      "Read(./.env.production*)",
      "Read(./.env.dev*)",
      "Read(./.env.development*)",
      "Read(./.env.stag*)",
      "Read(./.env.test*)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.*.local)",
      "Edit(./.env.prod*)",
      "Edit(./.env.production*)",
      "Edit(./.env.dev*)",
      "Edit(./.env.development*)",
      "Edit(./.env.stag*)",
      "Edit(./.env.test*)",
      "Read(./**/secrets/**)",
      "Edit(./**/secrets/**)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(gh pr merge *)",
      "Bash(gh release *)",
      "Bash(git push --tags *)",
      "Bash(git push origin v*)",
      "Bash(git push origin refs/tags/*)",
      "Bash(docker push *)",
      "Bash(docker login *)",
      "Bash(rm -rf *)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.config/gh/**)",
      "Read(~/.hermes/**/.env)",
      "Bash(printenv*)",
      "Bash(env)",
      "Read(./**/.env)",
      "Edit(./**/.env)",
      "Bash(set)",
      "Bash(export -p)",
      "Bash(declare -x)",
      "Bash(declare -p)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-secrets.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh"
          }
        ]
      }
    ]
  }
}
